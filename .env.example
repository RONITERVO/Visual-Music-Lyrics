# Firebase web app config. When these are set, the app requires Google sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Local-only bypass for UI verification. Leave false/blank in production.
VITE_DISABLE_FIREBASE_AUTH=

# Optional local override. Production uses Firebase Hosting same-origin rewrites, so leave this blank.
VITE_API_BASE_URL=

# Cloud Functions control plane.
FUNCTION_REGION=europe-west1
APP_URL=https://YOUR_FIREBASE_HOSTING_DOMAIN
GEMINI_API_KEYS=
GEMINI_TRANSLATE_MODEL=gemini-flash-lite-latest
GEMINI_KEY_MAX_CONCURRENCY=1
GEMINI_KEY_REQUESTS_PER_MINUTE=12
GEMINI_KEY_REQUESTS_PER_DAY=0
GEMINI_USER_REQUESTS_PER_MINUTE=6
GEMINI_USER_REQUESTS_PER_DAY=120

# Stripe is the payment service provider. Google Pay is enabled in Stripe after domain registration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=eur
ELEVENLABS_PRICE_CENTS_PER_HOUR=100
ELEVENLABS_MIN_PURCHASE_SECONDS=3600

# Cloud Run media plane.
FIREBASE_AUTH_REQUIRED=true
ELEVENLABS_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_MAX_CONCURRENT_JOBS=1
YOUTUBE_JOB_QUEUE_LIMIT=8

# Optional yt-dlp authentication for Cloud Run when YouTube blocks anonymous requests.
# Export a cookies.txt file from a browser, then base64 encode the file contents.
YOUTUBE_COOKIES_BASE64=
# Or point to a Netscape cookies.txt file mounted on the service.
YOUTUBE_COOKIES_FILE=
