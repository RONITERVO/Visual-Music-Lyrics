# ElevenLabs Scribe v2 Realtime
ELEVENLABS_API_KEY=

# Server-side Google Gemini API pool for gemini-flash-lite-latest translation.
# Use one key or comma/newline-separated keys from projects you own.
GEMINI_API_KEYS=
GEMINI_KEY_MAX_CONCURRENCY=1
GEMINI_KEY_REQUESTS_PER_MINUTE=12
GEMINI_KEY_REQUESTS_PER_DAY=0
GEMINI_USER_REQUESTS_PER_MINUTE=6
GEMINI_USER_REQUESTS_PER_DAY=120

# Optional YouTube Data API v3 key for richer channel metadata. Leave blank for no-key imports.
YOUTUBE_API_KEY=

# Keep this at 1 on Render's free tier to prevent overlapping yt-dlp jobs from exhausting memory.
YOUTUBE_MAX_CONCURRENT_JOBS=1
YOUTUBE_JOB_QUEUE_LIMIT=8

# Optional yt-dlp authentication for Render/cloud hosts when YouTube blocks anonymous requests.
# Export a cookies.txt file from a browser, then base64 encode the file contents.
YOUTUBE_COOKIES_BASE64=
# Or point to a Netscape cookies.txt file mounted on the server.
YOUTUBE_COOKIES_FILE=

# Frontend origin for hosted deployments, for example https://ronitervo.github.io.
APP_URL=
