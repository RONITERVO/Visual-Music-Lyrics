{
  "name": "living-sketchbook-music",
  "private": true,
  "version": "0.1.0",
  "description": "A local music visualizer for synced bilingual lyrics.",
  "license": "Apache-2.0",
  "author": "Roni Tervo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RONITERVO/Audio-visualizer-ai-studio-edition.git"
  },
  "bugs": {
    "url": "https://github.com/RONITERVO/Audio-visualizer-ai-studio-edition/issues"
  },
  "homepage": "https://github.com/RONITERVO/Audio-visualizer-ai-studio-edition#readme",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:app && npm run build:server && npm run build:functions",
    "build:app": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:functions": "npm --prefix functions ci && npm --prefix functions run build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "ws": "^8.21.0",
    "youtube-dl-exec": "^3.1.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
